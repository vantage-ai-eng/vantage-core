{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.vantageai.cc/schemas/runtimeai.suite/v1.json",
  "title": "RuntimeAI suite object",
  "description": "Multi-path ship-decision surface. Input to `vantage-core suite run`.",
  "type": "object",
  "required": ["schema", "id", "paths"],
  "properties": {
    "schema": { "const": "runtimeai.suite/v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "fail_policy": {
      "type": "string",
      "enum": ["all_must_pass", "threshold"],
      "default": "all_must_pass"
    },
    "min_passed": {
      "type": "integer",
      "minimum": 1,
      "description": "Required when fail_policy is threshold."
    },
    "cost_ceiling_usd": { "type": "number", "minimum": 0 },
    "model": { "type": "string" },
    "fail_under": { "type": "number" },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "contract": { "type": "string" },
              "file": { "type": "string" },
              "id": { "type": "string" }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
